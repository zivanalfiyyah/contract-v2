# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Signs and verifies login session tokens. REQUIRED in production —
# the server refuses to start without it outside of development. Must be a
# long random value, unique per environment, and never committed to git.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# DATABASE_URL: Postgres connection string. REQUIRED — the persistence layer
# (db.ts) refuses to start without it. Any standard Postgres works (a local
# instance, Docker, RDS, etc); a free serverless option that needs no local
# setup is Neon (neon.tech) or Supabase (supabase.com) — create a project,
# copy the connection string from the dashboard.
# Format: postgresql://user:password@host/dbname?sslmode=require
# Migrating an existing SQLite (app.db) install: run
#   npx tsx migrate-to-postgres.ts
# once, after setting this, to copy all existing data across.
DATABASE_URL=""

# SMTP: Transactional email (external signing links, shared PDF documents).
# Optional — without these, the app falls back to manual mailto:/wa.me links
# instead of sending automatically. Works with any SMTP provider (Gmail app
# password, SendGrid, Mailgun, AWS SES, your own mail server, etc).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Smart CLM Enterprise"

# VAPID keys: required for Web Push notifications (deadline reminders, status
# changes, new comments) to work. Optional — without these, push endpoints
# respond 503 and the app simply won't offer to subscribe.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:admin@yourcompany.com"

# STORAGE: file uploads (contract PDFs/scans). Optional on Render/VPS — without
# these, files are written to the local uploads/ folder on this server, which
# does NOT survive redeploys/restarts on platforms like Heroku/Cloud Run and
# can't be shared across multiple server instances.
# REQUIRED on Vercel: its functions run on a read-only filesystem, so there is
# no local-disk fallback at all there — file uploads fail with a clear error
# until these are set. Fill these in to use any S3-compatible object storage:
# AWS S3, Cloudflare R2, MinIO, or GCS via its S3-interop endpoint.
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# STORAGE_REGION: "auto" works for Cloudflare R2; use a real AWS region
# (e.g. "ap-southeast-1") for AWS S3.
STORAGE_REGION="auto"
# STORAGE_ENDPOINT: required for R2/MinIO/GCS-interop (e.g.
# https://<accountid>.r2.cloudflarestorage.com for R2). Leave empty for real AWS S3.
STORAGE_ENDPOINT=""
# STORAGE_PUBLIC_URL_BASE: public URL prefix files are served from (e.g. a
# R2 public bucket URL or CDN domain). If empty, a best-effort URL is built
# from STORAGE_ENDPOINT/STORAGE_BUCKET or the standard AWS S3 URL shape.
STORAGE_PUBLIC_URL_BASE=""
# STORAGE_FORCE_PATH_STYLE: set "true" for MinIO/most S3-compatible servers
# that need bucket-in-path URLs instead of virtual-hosted-style.
STORAGE_FORCE_PATH_STYLE="false"

# NODE_ENV: set to "production" on every real deployment (Render/Vercel/VPS).
# Controls the auth cookie's `secure` flag (HTTPS-only) and whether the app
# serves the built dist/ instead of booting Vite's dev server.
NODE_ENV="production"

# CRON_SECRET: only used on Vercel. Vercel automatically sends
# `Authorization: Bearer $CRON_SECRET` when it invokes /api/cron/reminders
# and /api/cron/backup on the schedule in vercel.json — set this to any
# random value so those endpoints reject requests without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Not needed on Render/VPS — those platforms run the setInterval schedulers
# in reminders.ts/backup.ts directly instead.
CRON_SECRET=""
